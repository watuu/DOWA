    .p-location
        .cm-block-header-page.cm-block-header-page--map
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("拠点一覧")
                    p.c-heading-page__label Location

        //- 日本地図。SPは幅が足りないので c-scroll-x で横に送る（ScrollHint は jsScrollX）
        //- Figma: SP 3344-15775 / PC 3304-19292
        .l-container
            .p-location-map.p-location-map--japan.c-scroll-x
                .c-scroll-x__inner.js-scroll-x
                    //- Figma のマスク済み書き出し。SP と PC でトリミングが違うので画像を2枚持つ
                    picture.p-location-japan
                        source(media="(min-width: 1024px)" srcset=img + "p-location-japan.webp" width=1360 height=800)
                        img.p-location-japan__img(src=img + "p-location-japan-sp.webp" alt="日本国内の拠点を示した地図" width=382 height=450)
                .c-scroll-x__bar(aria-hidden="true")
                    span.c-scroll-x__thumb

        .l-container
            +location-block("国内一覧", domestic)

            .c-line-dot.p-location-catch__line.u-only-sp(aria-hidden="true")
            p.p-location-catch
                span.p-location-catch__icon
                    svg(aria-hidden="true")
                        use(href="#ico_pin")
                //- Figma は「全国に」。国内一覧 → 世界地図の流れなので「世界に」（2026-09-18 デザイナー確認 No.6）
                span 世界に触媒集荷拠点を設けています

            //- 世界地図。ラベルは画像に焼き込まず、HTMLのテキストリンクで重ねる（ホバーで色が変わる）
            //- Figma: SP 3344-13235 / PC 3344-10646
            .p-location-map.p-location-map--world.c-scroll-x
                .c-scroll-x__inner.js-scroll-x
                    .p-location-world
                        img.p-location-world__img(src=img + "p-location-world.webp" alt="世界各地の拠点を示した地図" width=1300 height=613 loading="lazy")
                        each pin in worldPins
                            a.p-location-world__label(href="#" + pin.id data-scroll-anchor style=(pin.right ? "right:" + pin.right + "%" : "left:" + pin.left + "%") + ";top:" + pin.top + "%")!= pin.label
                .c-scroll-x__bar(aria-hidden="true")
                    span.c-scroll-x__thumb

            +location-block("海外一覧", overseas)
