extends ../_default
block vars
    - var path = "../"
    - var title = "お取引の流れ"
    - var pageClass = "page-flow"
    - var breadcrumb = "お取引の流れ"

block content

    -
        //- 文言は PC 版に合わせている（SP版と違う箇所は doc/design-tokens.md 参照）
        var steps = [
            { title: "お問い合わせ・ご相談", desc: "使用済み触媒の種類や数量などをお知らせください。<br class=\"u-only-pc\">お客様の条件に応じて、最適な取引方法をご提案いたします。", btn: { label: "お問い合わせ", url: "contact/" } },
            { title: "原料の出所調査 /<br>デューディリジェンス", desc: "責任ある調達ポリシーに則って、お客様や原料の出所に関するリスクを事前に確認します。", link: { label: "責任ある調達について", url: "supply-chain/" } },
            { title: "受入・破砕・サンプリング", desc: "お預かりした原料は、均一に粉砕・縮分を行った後、代表性の高いサンプルを採取します。正確な評価を行うために、このサンプリング工程が重要な役割を担います。", link: { label: "サンプリングについて", url: "technology/" } },
            { title: "受入数量確定", desc: "水分込みの重量および、水分を除いた乾燥重量が確定します。" },
            { title: "分析値判明/原料代金の精算", desc: "採取したサンプルを、政府認定の総合分析機関「DOWAテクノリサーチ」が分析。PGM含有量を正確に評価し、その分析値をもとに原料代を精算し、お客様から受け取った原料中の貴金属を買い取ります。", link: { label: "分析について", url: "technology/" } }
        ]
        //- 文言は doc の「よくある質問(DOWA).docx」より
        var faqs = [
            {
                q: "DOWAとの取引を行うことのメリットは？",
                a: ["DOWAでは、高いサンプリング技術と信頼性の高い分析により、使用済み触媒に含まれる貴金属を正確に評価します。原料本来の価値を適切に評価することで、お客様に納得感のある取引を提供します。また、長年培ってきたPGMリサイクル製錬技術を活かした効率的な操業により、競争力のある取引条件をご提案致します。"]
            },
            {
                q: "TC/RCとは何ですか？",
                a: [
                    "TCはTreatment Chargeの略で、原料を処理するための製錬費を指します。",
                    "RCはRefining Chargeの略で、回収した金属を精製するための精製費を指します。",
                    "買取価格を算定する際には、含有する貴金属の価値から、これらの費用やその他の条件を差し引いて計算します。"
                ]
            },
            {
                q: "回収率とは何ですか？",
                a: ["回収率とは、原料に含まれる貴金属量のうち、何％がお支払い対象となるかを示す契約条件の割合です。回収率が高いほど売却時にお支払い対象となる割合は大きくなりますが、実際の支払額は、原料に含まれる貴金属量が正確に評価されているかによっても大きく変わります。原料の種類や品位、取引条件によって回収率は異なりますので、まずはお問合せ下さい。"]
            },
            {
                q: "買取時の指標価格は何ですか？",
                a: ["適用する価格指標や値決め方法は、お取引条件や契約内容によって異なりますので、詳細は個別にご案内いたします。"]
            },
            {
                q: "同じコードの触媒でも、貴金属含有量は変わりますか？",
                a: ["はい、同じコードや同じ種類に見える触媒でも、1つ1つの貴金属含有量にはばらつきがあります。自動車触媒は、車種、年式、使用状況、劣化状態などにより、含まれるプラチナ、パラジウム、ロジウムの量が異なるためです。DOWAでは、お客様の原料本来の価値を適切に評価するため、買い取る原料の全量をサンプリングラインに通し、分析結果に基づいて評価を行っています。"]
            },
            {
                q: "値決めのタイミングはいつですか？",
                a: ["一般的には、分析によって確定した貴金属量に対して、合意した価格指標や値決め方法に基づき価格を決定します。詳細は個別にご案内いたしますので、お気軽にお問い合わせください。"]
            },
            {
                q: "支払いタームはどのようになりますか？",
                a: ["原料の受入、サンプリング、分析、評価をもとに、お客様と合意した条件に基づきお支払いを実施します。詳細な支払い時期や条件は、お取引開始時に個別にご案内いたします。"]
            },
            {
                q: "使用済み触媒はどなたから買い取っていますか？",
                a: [
                    "DOWAでは、主に事業者のお客様から使用済み触媒を受け入れています。",
                    "取引先には、製造メーカー、自動車解体業者、非鉄金属リサイクル業者などが含まれます。安心してお取引いただくため、LPPMの責任ある調達に関する考え方に基づき、全てのお取引先に対して会社情報や原料の出所等についてデューデリジェンスを実施しています。"
                ]
            },
            {
                q: "使用済み触媒は1個単位で買い取っていますか？",
                a: ["原則として、1個単位の個別買取ではなく、ロット単位で受け入れた原料をサンプリング・分析し、その結果に基づいて評価します。"]
            },
            {
                q: "支払額はいくらになりますか？",
                a: ["支払額は、原料に含まれるプラチナ、パラジウム、ロジウムなどの貴金属量、適用されるメタル価格、回収率、TC/RC、その他の契約条件に基づいて算定します。"]
            },
            {
                q: "DOWAに販売するには、どのようなライセンスや書類が必要ですか？",
                a: [
                    "必要な書類は、国・地域、原料の種類、取引形態によって異なります。",
                    "一般的には、会社情報、事業内容、許認可を確認できる公的な書類、盗難品ではないことの宣誓書などをご提出いただきます。法令や責任ある調達の基準に適合しない原料については、受入をお断りしています。"
                ]
            },
            {
                q: "ロットサイズはどれくらいにするべきですか？",
                a: [
                    "適切なロットサイズは、原料の種類、数量、荷姿、サンプリング方法によって異なります。",
                    "小ロットから大口ロットまで、内容に応じて最適な取引方法をご提案しますので、まずはお問い合わせください。"
                ]
            },
            {
                q: "引き取りサービスはありますか？",
                a: ["原料の所在地、数量、荷姿、取引条件によっては、輸送や引き取り方法についてご相談いただけます。お客様の状況に応じて、最適な納入方法をご提案しますので、まずはお問い合わせください。"]
            },
            {
                q: "電子スクラップの買取は行っていますか？",
                a: [
                    "電子スクラップについては、DOWAグループ内で取り扱い可能な場合があります。",
                    "NPGMは主に使用済み自動車触媒などのPGM含有原料を対象としていますが、電子基板などの原料については、内容に応じてグループ会社での対応をご案内できる場合があります。まずは原料の種類や数量をご相談ください。"
                ]
            }
        ]

    .p-flow
        .cm-block-header-page.cm-block-header-page--lead
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("お取引の流れ")
                    p.c-heading-page__label Flow

        section.p-flow-body
            .l-container
                p.p-flow-lead
                    | 初めてのお取引でも安心してご利用いただけるよう、原料納入から分析、評価、最終決済までの流れをご紹介します。
                    br
                    | お客様の原料やご要望に応じて、最適な取引方法をご提案いたしますので、まずはお気軽にご相談ください。

                ol.p-flow-steps
                    each s, i in steps
                        li.c-card-step
                            p.c-card-step__num= i + 1
                            .c-card-step__main
                                figure.c-card-step__figure
                                    img(src=img + "p-flow-pic" + (i + 1) + ".webp" alt="" width=840 height=560 loading=(i > 0 ? "lazy" : "eager"))
                                .c-card-step__body
                                    h2.c-card-step__title!= s.title
                                    p.c-card-step__desc!= s.desc
                                    if s.btn
                                        .c-card-step__action
                                            a.c-btn(href=path + s.btn.url)
                                                span.c-btn__label= s.btn.label
                                                span.c-btn__arrow
                                                    svg(aria-hidden="true")
                                                        use(href="#ico_arrow_r")
                                    if s.link
                                        .c-card-step__action
                                            a.c-link-arrow(href=path + s.link.url)
                                                span.c-link-arrow__label= s.link.label
                                                span.c-btn-arrow.c-link-arrow__arrow
                                                    svg(aria-hidden="true")
                                                        use(href="#ico_arrow_r")
                    li.c-card-step.c-card-step--end
                        p.c-card-step__num 6
                        .c-card-step__main
                            .c-card-step__body
                                h2.c-card-step__title 製錬/精製プロセスへ

        section.p-flow-faq
            .l-container
                .p-flow-faq__inner
                    h2.c-heading-sub
                        span.c-marker
                            svg(aria-hidden="true")
                                use(href="#ico_marker")
                        span よくあるご質問
                    .p-flow-faq__list.c-accordion
                        each q, i in faqs
                            .c-accordion__item
                                button.c-accordion__head.js-accordion(type="button" aria-expanded="false" aria-controls="faq-" + (i + 1))
                                    span.c-accordion__q= q.q
                                    span.c-accordion__icon
                                        svg(aria-hidden="true")
                                            use(href="#ico_tri_d")
                                .c-accordion__body(id="faq-" + (i + 1))
                                    p.c-accordion__answer!= q.a.join("<br>")
