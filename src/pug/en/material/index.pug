extends ../../_default
block vars
    - var path = "../../"
    - var lang = "en"
    - var slug = "material/"
    - var title = "What We Buy"
    - var pageClass = "page-material"
    - var breadcrumb = "Materials We Purchase"

//- 英訳は「英訳確認シート」03 買取原料
block content

    -
        var materials = [
            { title: "Spent Automotive Catalysts", desc: "We purchase spent automotive catalysts both with and without their canisters. Decanning services are also available to meet individual customer requirements." },
            { title: "Metal Honeycomb Catalysts", desc: "In metal honeycomb catalysts, PGMs are contained in the washcoat applied to the metal substrate. The washcoat is separated through a dedicated pre-treatment process to enable accurate sampling and analysis." },
            { title: "Chemical Catalysts", desc: "We purchase spent catalysts used in petroleum refining and chemical manufacturing. Our large-scale sampling and smelting facilities enable us to accommodate lots exceeding 10 metric tons." },
            { title: "Other PGM-Bearing Materials and Production Residues", desc: "We handle a wide range of other PGM-bearing materials, including production residues and process by-products. After reviewing a sample, we propose a suitable recycling solution based on the characteristics of the material." }
        ]

    .p-material
        .cm-block-header-page
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("What We Buy")
                    p.c-heading-page__label What We Buy

        section.p-material-body
            .l-container
                .p-material-list
                    each m, i in materials
                        if i > 0
                            .c-line-dot(aria-hidden="true")
                        .c-card-num
                            .c-card-num__body
                                p.c-card-num__num #0#{i + 1}
                                .c-card-num__text
                                    h2.c-card-num__title= m.title
                                    p.c-card-num__desc= m.desc
                            figure.c-card-num__figure
                                img(src=img + "p-material-pic" + (i + 1) + ".webp" alt="" width=1458 height=998 loading=(i > 0 ? "lazy" : "eager"))
