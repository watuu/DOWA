extends ../../_default
block vars
    - var path = "../../"
    - var lang = "en"
    - var slug = "privacy-policy/"
    - var title = "Privacy Policy"
    - var pageClass = "page-privacy"
    - var breadcrumb = "Privacy Policy"

//- 文言は doc/20260817改定_個人情報保護方針_日英.docx の英語版（DOWAメタルマイン株式会社・2026年8月17日改正）。
//- 日本語ページ（src/pug/privacy-policy）も同じ版（2026-09-16 差し替え）
block content

    -
        var purposeBlocks = [
            { title: "Personal information of customers contacting us for inquiry", items: ["To reply to customers contacting us for inquiry, verify their identities, confirm the details of their inquiry and respond to them"] },
            { title: "Personal information of business partners (including prospective business partners)", items: ["To provide information regarding proper use, quality, safety and effectiveness, etc. of services and products", "To exercise and perform the rights and obligations related to transactions", "For the collection of information necessary for business operations or for business contact purpose, etc."] },
            { title: "Personal information of shareholders", items: ["To exercise and perform the rights and obligations under the Companies Act", "To send a year-end report and other distributions and communication", "For the management of shareholders, including preparation of shareholders data pursuant to the specified criteria based on various laws and regulations", "For administration work in relation to the preparation and submission of payment records"] },
            { title: "Personal information of researcher and academics who are working on our research and development", items: ["To develop better products and services in each business field and conduct research and study for the development", "For the collection of information necessary for business operations or for business contact purpose, etc."] },
            { title: "Personal information of civil servant such as a contact person of concerned public office", items: ["To obtain required permits and licenses", "To report an incident or recall when it occurs", "For the collection of information necessary for business operations or for business contact purpose"] },
            { title: "Personal information of participants/members of the association which we are a member of", items: ["For the collection of information necessary for business operations or for business contact purpose"] },
            { title: "Personal information of reporters, analysts, and institutional investors relating to PR/IR activities", items: ["To send a year-end report and other distributions and communication", "For the collection of information necessary for business operations or for business contact purpose"] },
            { title: "Personal information of users and guests of training or resort facilities", items: ["To create a hotel register pursuant to the Hotel Business Act", "For the confirmation of users and guests", "For business contact purpose"] },
            { title: "Personal information of neighborhood of our facilities", items: ["To contact in case of emergency or necessity"] },
            { title: "Personal information of job applicants", items: ["For employee screening", "For the management of prospective employees", "To provide information for publicizing employment opportunities information", "For the enhancement of recruitment activities"] },
            { title: "Personal information of retirees", items: ["For the payment of company retirement pension, etc.", "For business contact, including sending of an invitation to alumni association", "To provide any information regarding company’s circumstances", "To send a year-end report and other distributions and communication"] }
        ]
        var safetyBlocks = [
            { title: "Establishment of basic policy", items: ["This policy has been established in order to ensure the appropriate handling of personal information and inform the contact point for inquiries and complaints."] },
            { title: "Establishment of rules for handling of personal data", items: ["We establish rules for the controlling of personal information with regard to handling methods, persons responsible or in charge as well as their duties, etc. for each stage of acquisition, use, storing, provision, deletion and destruction of personal data."] },
            { title: "Organizational Security Measures", items: ["We assign an officer who is responsible for the handling of personal data (Chief Privacy Officer).", "We clarify which employees handle personal data and the scope of personal data to be handled by such employees.", "We establish a system to ensure that any breach or possible breach of laws or any internal rules is reported to Chief Privacy Officer when it is noticed.", "We perform a regular self-check on the handling of personal information, along with an audit by other departments or external auditors."] },
            { title: "Human Security Measures", items: ["We provide our employees with training on a regular basis on the matters concerning the handling of personal information.", "We specify the matters concerning confidentiality of personal information in the rules of employment."] },
            { title: "Physical Security Measures", items: ["In areas where personal information is handled, we control the entry and exit of employees, restrict the devices brought into those areas, and take the measures to prevent an unauthorized person from viewing personal information.", "We take the measures for securing devices, electric medium and documents, etc. containing personal information from theft or loss.", "We take the measures to protect devices and electronic medium containing personal information so that the personal information is not easily revealed when they are carried around, including being moved within the office."] },
            { title: "Technical Security Measures", items: ["We implement access control to limit the persons in charge and the scope of personal information being handled.", "We introduce a system to protect the information system for handling personal information from being externally accessed by someone who is not authorized or malware."] },
            { title: "Understanding of external environment", items: ["We take these security measures with the understanding of the personal information security system introduced in foreign countries where our group companies keeping personal information are located (please see the “Group Companies List” available in our website)"] }
        ]
        //- (2) の「attached sheet」は日本語ページの PDF（共同利用者一覧）と同じものを想定。リンク先は未定
        var sharedBlocks = [
            { no: "01", title: "Personal data items that may be jointly used", body: "Name (if you are a company, name of an officer/employee and its title and affiliation), address, date of birth, sex, phone number, fax number, email address, and contents of inquiry" },
            { no: "02", title: "Scope of joint users", body: "The joint users shall be as specified in the attached sheet.", pdf: { label: "List of Joint Users", size: "(53KB)" } },
            { no: "03", title: "Purposes of use by joint users", body: "Same as ones listed in Articles 1 hereof." },
            { no: "04", title: "Party responsible for management of personal information", body: "DOWA HOLDINGS CO., LTD.<br>Please refer to the following URL for the address and representative’s name:", url: "https://hd.dowa.co.jp/en/company/summary.html" }
        ]

    mixin postBlocks(blocks)
        .cm-policy__blocks
            each b in blocks
                .cm-policy__block
                    h4.cm-policy__subtitle
                        span.c-marker
                            svg(aria-hidden="true")
                                use(href="#ico_marker")
                        span!= b.title
                    ul.c-list-bullet
                        each item in b.items
                            li= item

    .p-privacy
        .cm-block-header-page
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("Privacy Policy")
                    p.c-heading-page__label Privacy Policy

        section.p-privacy-body
            .l-container
                .cm-block-panel.cm-block-panel--policy
                    p.cm-block-lead DOWA METALS &amp; MINING CO., LTD. (“DOWA”, “we”, “us” or “our”), in recognition of the importance of securing your personal information, has implemented the following policy to appropriately manage and use personal information in compliance with the provisions of the Act on the Protection of Personal Information (the “Act”) and other laws and regulations and guidelines related thereto, striving to meet your expectations.

                    .p-privacy-body__main.cm-policy
                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 1. Purposes of Use of Personal Information
                                p We use personal information within the scope of the purposes listed below. If any personal information is used for any other purpose, we will, at the time of acquisition of such information, separately specify the purpose of use and announce or notify the person concerned of it, and we will handle the personal information within the scope of the specified purpose of use.
                            +postBlocks(purposeBlocks)

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 2. Security Measures
                                p With respect to personal information, we have implemented the measures for the prevention of leakage, loss or damage and for other proper control of the personal data. Furthermore, the measures for other proper control of the personal data include measures necessary and appropriate to prevent leakage etc. of the personal information acquired or to be acquired by us and planned for handling as personal data.
                            +postBlocks(safetyBlocks)

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 3. Provision of Personal Information to a Third Party
                                p Unless otherwise permitted by laws and regulations, we shall not provide your personal information to any third party without your prior consent. When we outsource the handling of your personal information to a third party, we will only disclose the personal information after the conclusion of an agreement imposing on such third party obligations to take adequate security measures.

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 4. Outsourcing
                                p We may outsource the processing of information such as analysis of browsing history of websites, etc. to a third party. In such case, we will provide necessary and adequate supervision to the outsourcing company in accordance with the Act.

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 5. Joint Use of Personal Information
                                p We may share your personal data within our group companies only when necessary. When jointly using your personal information, we will handle it in compliance with the Act and any other related laws and regulations.
                            .cm-policy__numbers
                                each b in sharedBlocks
                                    .cm-policy__number
                                        h4.cm-policy__number-title
                                            span.cm-policy__no= b.no
                                            span= b.title
                                        p
                                            != b.body
                                            if b.url
                                                a.c-link-url(href=b.url target="_blank" rel="noopener")= b.url
                                        if b.pdf
                                            a.c-link-pdf(href="#" target="_blank" rel="noopener")
                                                span.c-link-pdf__label= b.pdf.label
                                                span.c-link-pdf__icon(aria-hidden="true")
                                                    span PDF
                                                span.c-link-pdf__size= b.pdf.size

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 6. Acquisition, Use and Provision of Information Associated with Identifiers Like Cookie
                                p A cookie is information that the websites send to your web browser and is stored in your device. A web beacon is a mechanism that uses a small image file embedded into a web page or email to transmit information when you browse or open the web page or email. This website uses cookies, web beacons or other similar technology to analyze information such as your browsing history of the website and use it for the following purposes.
                            ul.c-list-bullet
                                li To enhance information and services provided through this website
                                li To inspect and eliminate any malfunction in order to ensure the technical operation on this website

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 7. Request for Disclosure of Retained Personal Data
                                p When a person or his/her agent requests the disclosure of his/her personal data retained by us, we will respond without delay, except for the cases below. If we decide not to disclose or there exists no such data, we will notify to that effect.
                            ul.c-list-bullet
                                li When the disclosure is likely to harm the life, body, property or other rights and interests of the person concerned or any third party
                                li When the disclosure is likely to cause significant hindrance to the performance of our business activities
                                li When the disclosure results in the violation of laws and regulations
                            p Furthermore, when a person or his/her agent requests rectification, addition or deletion, or cessation of use, or suspension of provision to a third party, of his/her personal data retained by us, we will conduct investigation and respond to such request accordingly in accordance with laws and regulations.
                            p Please note that we may request submission of documents required for disclosure request, how to request and a form of identification to verify the requester’s identity.
                            p If you have any questions on the above, please contact us at:
                            p
                                | DOWA METALS &amp; MINING CO., LTD.
                                br
                                | Strategic Planning Department
                                br
                                | Tel:#{" "}
                                span.u-font-en +81-3-6847-1200

                        .cm-policy__section
                            .cm-policy__head
                                h3.cm-policy__title 8. Contact for inquiries and complaints
                                p If you have any questions or complaints about our handling of personal information, please contact us at:
                            .p-privacy-contact
                                p
                                    | DOWA METALS &amp; MINING CO., LTD.
                                    br
                                    | Strategic Planning Department
                                    br
                                    | Tel:#{" "}
                                    span.u-font-en +81-3-6847-1200

                                .p-privacy-imprint
                                    p
                                        | December 1st, 2022
                                        br
                                        | amended on May 20, 2024 (Effective April 1, 2024)
                                        br
                                        | amended on March 27, 2025 (Effective October 21, 2024)
                                        br
                                        | amended on August 6, 2026 (Effective April 1, 2026)
                                        br
                                        | amended on August 17, 2026 (Effective April 1, 2026)
                                    p
                                        | Shigeki Sato
                                        br
                                        | President
                                        br
                                        | DOWA METALS &amp; MINING CO., LTD.
                                        br
                                        | 14-1, Sotokanda 4-chome, Chiyoda-ku, Tokyo 101-0021, Japan
