extends ../../../_default
block vars
    - var path = "../../../"
    - var lang = "en"
    - var slug = "contact/thanks/"
    - var title = "Thank You for Your Inquiry"
    - var pageClass = "page-contact"
    - var noindex = true
    - var breadcrumb = [{ label: "Contact", url: "contact/" }, "Thank You"]

//- 日本語の contact/thanks/ の英語版。英訳確認シートに完了画面の原稿が無いため機械翻訳（2026-09-21）。
//- 原稿が届いたら差し替える（doc/english-pages.md）
block content

    .p-contact
        .cm-block-header-page
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("Contact")
                    p.c-heading-page__label Contact

        section.p-contact-thanks
            .l-container
                .cm-block-panel
                    .cm-thanks
                        p Thank you for contacting us.
                        p
                            | We have received your inquiry and appreciate you taking the time to write to us.
                            br
                            | Our team will review your message and respond within one week. A confirmation email has also been sent automatically to the address you provided.
                        p.cm-thanks__gap
                            | If you do not receive that email after some time, the address you entered may be incorrect, or our message may have been filtered into your junk mail folder.
                            br
                            | If you use domain-based filtering, please make sure that emails from “#[span.u-font-en @dowa-pgm.com]” can be received.
                            br
                            | After checking the above, please submit the form again.
                        p.cm-thanks__gap
                            | If your inquiry is urgent, you are also welcome to call us at #[span.u-font-en +81-3-6847-1205].

                    .cm-thanks-action
                        a.c-btn.c-btn--action(href=home)
                            span.c-btn__label Back to Home
                            span.c-btn__arrow
                                svg(aria-hidden="true")
                                    use(href="#ico_arrow_r")
