extends ../../../_default
block vars
    - var path = "../../../"
    - var lang = "en"
    - var slug = "document/thanks/"
    - var title = "Thank You for Your Request"
    - var pageClass = "page-document"
    - var noindex = true
    - var breadcrumb = [{ label: "Download Materials", url: "document/" }, "Thank You"]

//- 日本語の document/thanks/ の英語版。英訳確認シートに完了画面の原稿が無いため機械翻訳（2026-09-21）。
//- 資料は「入力されたメールアドレスへダウンロードURLを送る」前提（日本語版と同じ）
block content

    .p-document
        .cm-block-header-page
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("Download Our Brochure")
                    p.c-heading-page__label Download

        section.p-document-thanks
            .l-container
                .cm-block-panel
                    .cm-thanks
                        p Thank you for requesting our brochure.
                        p
                            | We have received your request and appreciate your interest in our services.
                            br
                            | A download link has been sent to the email address you provided. Please use the link in that email to view the brochure.
                        p.cm-thanks__gap
                            | If you do not receive that email after some time, the address you entered may be incorrect, or our message may have been filtered into your junk mail folder.
                            br
                            | If you use domain-based filtering, please make sure that emails from “#[span.u-font-en @dowa-pgm.com]” can be received.
                            br
                            | After checking the above, please submit the form again.
                        p.cm-thanks__gap
                            | For questions about the brochure or about selling your materials, please feel free to use our contact form.
                            br
                            | If your request is urgent, you are also welcome to call us at #[span.u-font-en +81-3-6847-1205].

                    .cm-thanks-action
                        a.c-btn.c-btn--action(href=home)
                            span.c-btn__label Back to Home
                            span.c-btn__arrow
                                svg(aria-hidden="true")
                                    use(href="#ico_arrow_r")
