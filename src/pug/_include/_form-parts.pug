mixin formRow(id, label, required)
    .cm-form-row
        label.cm-form-row__label(for=id)
            = label
            if required
                span.c-form-required 必須
        .cm-form-row__field
            block

mixin formText(id, name, label, placeholder, required, type)
    +formRow(id, label, required)
        input.c-input(id=id type=(type || "text") name=name placeholder=placeholder required=required)

mixin formSelect(id, name, label, options, required)
    +formRow(id, label, required)
        .c-select
            select(id=id name=name required=required)
                option(value="") 選択してください
                each opt in options
                    option(value=opt)= opt
            span.c-select__arrow
                svg(aria-hidden="true")
                    use(href="#ico_tri_r")

mixin formAgree(path)
    label.c-checkbox
        input(type="checkbox" name="agree" required)
        span
            a(href=path + "privacy-policy/") 個人情報の取り扱い
            |  に関して同意する

mixin formSubmit(label)
    button.c-btn.c-btn--action(type="submit")
        span.c-btn__label= label
        span.c-btn__arrow
            svg(aria-hidden="true")
                use(href="#ico_arrow_r")
