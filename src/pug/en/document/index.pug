extends ../../_default
include ../../_include/_form-parts
block vars
    - var path = "../../"
    - var lang = "en"
    - var slug = "document/"
    - var title = "Download Our Brochure"
    - var pageClass = "page-document"
    - var breadcrumb = "Download Materials"

//- 英訳は「英訳確認シート」08 資料ダウンロード。利用目的の選択肢は機械翻訳（2026-09-16）。
//- 電話番号は「海外のお問合せフォームでは国番号が入力できるようにしたい」（シートの備考）→ WP のフォーム実装で対応
block content

    .p-document
        .cm-block-header-page
            .l-container
                .c-heading-page
                    h1.c-heading-page__title
                        +split-chars("Download Our Brochure")
                    p.c-heading-page__label Download

        section.p-document-form
            .l-container
                .cm-block-panel
                    p.cm-block-lead Download our brochure to learn more about our catalyst purchasing services, accepted materials, transaction process, and PGM recycling capabilities.

                    form.p-document-form__body.cm-form(action="#" method="post" onsubmit="return false;")
                        .cm-form__body
                            .cm-form__rows
                                +formText("d-name", "name", "Name", "Please enter your name.", true)
                                +formText("d-email", "email", "Email address", "Please enter your email address.", true, "email")
                                +formText("d-company", "company", "Company name", "Please enter your company name.", true)
                                +formText("d-tel", "tel", "Phone number", "Please enter your phone number.", true, "tel")
                                +formSelect("d-purpose", "purpose", "Purpose of Download", ["Considering selling materials", "Gathering information", "Other"], true)
                            +formAgree(home)
                        +formSubmit("Review Your Information")
