extends ../_default
block vars
    - var path = "../"
    - var title = "責任ある調達"
    - var pageClass = "page-supply"
    - var breadcrumb = "責任ある調達"

block content

    -
        var policies = [
            { title: "国際基準に基づく調達管理", desc: "製錬所には、原料の由来や紛争・人権・環境リスクを確認する責任があります。DOWAメタルマイン、および日本ピージーエムは、サプライチェーンの透明性を確保し、リスクの高い触媒や原料を取り扱わない体制を構築しています。" },
            { title: "OECD/LPPMに準拠した責任ある調達方針", desc: "DOWAメタルマインは、OECDのガイダンスに基づき、リスクのある鉱物を使用しない方針を採用しています。さらに、年1回の第三者監査と情報公開を通じて、透明性と信頼性の高い調達体制を維持しています。", banner: true }
        ]
        //- 欧文（Figma は Roboto Condensed）は u-font-en で Poppins にする
        var docs = [
            { title: "お客様にご用意頂く書類", items: ["本人確認書類", "履歴事項全部証明書", "事業許可証", "納税者番号(<span class=\"u-font-en\">VAT</span>証明書)"] },
            { title: "お渡ししてご記入頂く書類", items: ["<span class=\"u-font-en\">LPPM</span> 責任ある調達に関する確認書<span class=\"u-font-en\">(OBQ)</span>", "<span class=\"u-font-en\">PGM</span>リサイクル取引に関する宣誓書"] }
        ]

    .p-supply
        .cm-block-header-page
            .l-container
                .c-heading-page
                    h1.c-heading-page__title 責任ある調達
                    p.c-heading-page__label Supply Chain

        section.p-supply-policy
            .l-container
                .p-supply-list
                    each p, i in policies
                        if i > 0
                            .c-line-dot(aria-hidden="true")
                        .c-card-num
                            .c-card-num__body
                                p.c-card-num__num #0#{i + 1}
                                .c-card-num__text
                                    h2.c-card-num__title= p.title
                                    p.c-card-num__desc= p.desc
                                if p.banner
                                    .c-card-num__action
                                        //- リンク先は未定（DOWAメタルマインの責任ある調達のページ）
                                        a.c-banner-link(href="#" target="_blank" rel="noopener" aria-label="DOWAメタルマイン株式会社 責任ある調達について（新しいウィンドウで開きます）")
                                            span.c-banner-link__body
                                                img.c-banner-link__logo(src=img + "logo-dowa-mm.svg" width=280 height=14 alt="")
                                                span.c-banner-link__label 責任ある調達について
                                            span.c-btn-arrow.c-btn-arrow--xs.c-btn-arrow--action.c-btn-arrow--tri
                                                svg(aria-hidden="true")
                                                    use(href="#ico_tri_d")
                            figure.c-card-num__figure
                                img(src=img + "p-supply-pic" + (i + 1) + ".webp" alt="" width=1458 height=998 loading=(i > 0 ? "lazy" : "eager"))

        section.p-supply-dd
            .l-container
                .p-supply-dd__inner
                    .p-supply-dd__head
                        h2.c-heading-marker
                            span.c-marker
                                svg(aria-hidden="true")
                                    use(href="#ico_marker")
                            span 取引開始前の<br class="sp">デューデリジェンス
                        p.p-supply-dd__lead 安心してお取引頂くために、お客様や原料の出所に関するリスクを事前に確認します。

                    ol.p-supply-dd__list
                        li.c-card-procedure
                            .c-card-procedure__head
                                p.c-card-procedure__num 1
                                h3.c-card-procedure__title 必要書類のご記入とご準備
                            .p-supply-docs
                                each d in docs
                                    .p-supply-docs__col
                                        h4.p-supply-docs__head= d.title
                                        ul.p-supply-docs__list
                                            each item in d.items
                                                li
                                                    span!= item
                        li.c-card-procedure
                            .c-card-procedure__head
                                p.c-card-procedure__num 2
                                h3.c-card-procedure__title リスクの特定と評価
                            p.c-card-procedure__desc コンプライアンス責任者が原料の出所や取引先を調査し、人権・環境・不正などのリスクを確認します。
                        li.c-card-procedure
                            .c-card-procedure__head
                                p.c-card-procedure__num 3
                                h3.c-card-procedure__title 現地訪問
                            p.c-card-procedure__desc
                                | 初回取引前に現地視察を実施し、お客様の操業状況やPGM含有触媒の保管状況を確認します。
                                br
                                | 初回取引後は、12か月〜18か月毎に継続的な現地視察を行います。
