extends ../_default
block vars
    - var path = "../"
    - var lang = "en"
    - var title = ""
    - var pageClass = "page-front"

//- 英訳は「DOWA 自動車触媒買取サイト 英訳確認シート」01 トップ。組みは日本語のトップ（src/pug/index.pug）と同じ
block content

    -
        var features = [
            { title: "Fair Valuation of Your Catalysts", desc: "Representative samples are analyzed to accurately determine the precious metal content of each lot. Based on the assay results and applicable market prices, we provide a clear and transparent purchase price." },
            { title: "Prompt Settlement", desc: "Our sales representatives and smelting engineers work closely together to ensure both speed and accuracy. This coordination streamlines the process from analysis through final settlement, enabling prompt payment." },
            { title: "Global sampling network", desc: "Through our global sampling network, we provide responsive support and accurate sampling closer to our customers, helping facilitate smooth and reliable transactions." },
            { title: "Dedicated Support for First-Time Customers", desc: "In Japan and overseas, we accommodate catalysts both with and without their canisters, as well as a wide range of lot sizes. We recommend an approach suited to each customer’s materials and requirements and provide clear support throughout the process." }
        ]
        //- お客様の声は保留（2026-09-16）。日本語のトップと同じ3件を、シートの対応する英訳で出している。
        //- 3件目のお客様名はシートの英訳（ロレンジャパン株式会社様）と日本語（アジア圏大手B社）が違うので、日本語に合わせて仮置き
        var voices = [
            { title: "Responsive Service and a Trusted Partnership", text: "We have appreciated the team’s professionalism and responsiveness throughout our business relationship. Communication is always smooth, and our inquiries and requests are handled promptly. We are particularly satisfied with the speed of payment and regard DOWA as a trusted and reliable business partner.", client: "Automotive Dismantler, Japan" },
            { title: "Reliable Service and Clear Communication", client: "Recycling Materials Collector, Asia" },
            { title: "More Than a Service Provider: A Trusted Partner", client: "Major Company B, Asia" }
        ]
        //- 新着情報は WP で入る。ここは仮の記事
        var news = [
            { date: "2025-12-31", label: "2025.12.31", tag: "News", title: "Notice of Year-End and New Year Holidays" },
            { date: "2025-12-15", label: "2025.12.15", tag: "News", title: "Updated the list of materials we purchase" },
            { date: "2025-11-28", label: "2025.11.28", tag: "News", title: "Updated information on our sampling and analysis capabilities" }
        ]

    -
        var points = [
            { text: "Accurate Analysis and Valuation", w: 30, h: 44 },
            { text: "Transparent Pricing", w: 32, h: 44 },
            { text: "Reliable and Consistent Transactions", w: 33, h: 44 },
            { text: "Flexible Handling of a Wide Range of Catalysts", w: 31, h: 45 }
        ]
        var strengthNums = [{ w: 67, h: 120 }, { w: 73, h: 119 }, { w: 82, h: 121 }]
        //- detail（ホバーで出る説明）の英訳は申請中（2026-09-16）。届くまで日本語のまま
        var strengths = [
            { name: "Sampling", detail: "お客様の原料をロットごとに丁寧に前処理し、原料全体を代表するサンプルを採取しています。高い精度が求められるPGM含有量の評価において、サンプリング工程は公正で信頼性の高い取引を支える重要な役割を担っています。" },
            { name: "Analysis", detail: "ICP（誘導結合プラズマ）分析をはじめとする高度な分析技術とトレーサブルな品質管理体制により、PGM元素の含有量を高い精度で測定・定量しています。" },
            { name: "Smelting & Refining", detail: "多種多様な原料を月間1,000トン規模で処理し、貴重な資源を効率的に回収するとともに、環境負荷の低減に取り組んでいます。" }
        ]
        //- 左列 1・3、右列 2・4（SP はこの順で縦積み）。英字ラベルは CSS で大文字になる
        var whats = [
            { n: 1, en: "Spent automotive catalysts", name: "Spent automotive catalysts" },
            { n: 2, en: "Chemical catalysts", name: "Chemical catalysts" },
            { n: 3, en: "Metal honeycomb catalysts", name: "Metal Honeycomb Catalysts" },
            { n: 4, en: "Other PGM-bearing materials & production residues", name: "Other PGM-Bearing Materials and Production Residues" }
        ]

    mixin what-card(w, i)
        a.p-top-what__card.u-anim.js-visible(href=home + "material/" style="--i: " + i)
            figure.p-top-what__figure.u-anim-zoom
                img(src=img + "p-top-what" + w.n + ".webp" alt="" width=1328 height=1328 loading="lazy")
            .p-top-what__text
                p.p-top-what__en= w.en
                h3.p-top-what__name= w.name

    .p-top

        //- MV。出す順番は common.js の jsMv()
        section.p-top-mv.is-section-dark.js-mv
            .p-top-mv__main
                .p-top-mv__movie.u-anim-fade.u-anim-zoom
                    video(src=movie + "mv.mp4" width=1920 height=1080 autoplay muted loop playsinline preload="auto" aria-hidden="true")
                .p-top-mv__copy
                    //- 日本語は SP と PC で文言が違うが、英訳は1つなので SP・PC とも同じ
                    h1.p-top-mv__title.u-anim-lines
                        span.u-anim-line(style="--l: 0")
                            span Precision Analysis.
                        span.u-anim-line(style="--l: 1")
                            span Fair Valuation.
                    p.p-top-mv__lead.u-anim(style="--i: 2") Backed by NIPPON PGM’s expertise in platinum group metals (PGMs), we provide reliable catalyst purchasing and recycling services tailored to each customer’s needs.
            .p-top-mv__gallery.u-anim-fade.u-anim-zoom
                ul.p-top-mv__track
                    each round in [0, 1]
                        each n in [1, 2, 3, 4, 5]
                            li.p-top-mv__item(aria-hidden=(round ? "true" : false))
                                img(src=img + "p-top-mv-gallery" + n + ".webp" alt="" width=406 height=406)

        //- Key Points
        section.p-top-point
            .l-container
                .c-heading-section.c-heading-section--center.p-top-point__head
                    p.c-heading-section__label.u-anim.js-visible What to Look for in a Catalyst Purchasing Partner
                    h2.c-heading-section__title.u-anim.js-visible(style="--i: 1") Key Points
                ol.p-top-point__list
                    each pt, i in points
                        li.p-top-point__item.u-anim.js-visible(style="--i: " + i)
                            img.p-top-point__num(src=img + "p-top-point-num" + (i + 1) + ".svg" alt=(i + 1) + "." width=pt.w height=pt.h)
                            span= pt.text
                p.p-top-point__closing.u-anim.js-visible
                    span.p-top-point__badge DOWA
                    |  brings together all the capabilities you need in a catalyst purchasing partner.

        //- Our strengths
        section.p-top-strength
            .l-container
                .c-heading-section.c-heading-section--center.p-top-strength__head
                    p.c-heading-section__label.u-anim.js-visible Our strengths
                    h2.c-heading-section__title.u-anim.js-visible(style="--i: 1") Our strengths
                .p-top-strength__intro
                    p.p-top-strength__title.u-anim-lines.js-visible
                        span.u-anim-line(style="--l: 0")
                            span An Integrated Recycling Process
                        span.u-anim-line(style="--l: 1")
                            span for Fair and Transparent Transactions
                    p.p-top-strength__lead.u-anim.js-visible(style="--i: 2") Through an integrated process covering sampling, assaying, and smelting, we provide accurate and transparent valuations that give customers confidence in every transaction.
                ol.p-top-strength__list
                    each s, i in strengths
                        li.p-top-strength__item.u-anim.js-visible(style="--i: " + i)
                            .p-top-strength__figure.u-anim-zoom
                                video(src=movie + "strength_0" + (i + 1) + ".mp4" width=1620 height=1080 autoplay muted loop playsinline aria-hidden="true")
                                .p-top-strength__detail(aria-hidden="true")
                                    p.p-top-strength__detail-title= s.name
                                    p.p-top-strength__detail-text= s.detail
                            h3.p-top-strength__name= s.name
                            img.p-top-strength__num(src=img + "p-top-strength-num" + (i + 1) + ".svg" alt="" width=strengthNums[i].w height=strengthNums[i].h loading="lazy")

        //- What We Buy（濃い帯）
        section.p-top-what.is-section-dark
            .l-container
                .c-heading-section.p-top-what__head
                    p.c-heading-section__label.u-anim.js-visible Materials We Purchase
                    h2.c-heading-section__title.u-anim.js-visible(style="--i: 1") What We Buy
                .p-top-what__body
                    .p-top-what__col
                        p.p-top-what__lead.u-anim.js-visible We purchase a wide range of spent catalysts and other PGM-containing materials.
                        +what-card(whats[0], 0)
                        +what-card(whats[2], 0)
                    .p-top-what__col
                        +what-card(whats[1], 1)
                        +what-card(whats[3], 1)
                        .p-top-what__action.u-anim.js-visible
                            a.c-btn.c-btn--md(href=home + "material/")
                                span.c-btn__label Learn more
                                span.c-btn-arrow
                                    svg(aria-hidden="true")
                                        use(href="#ico_arrow_ne")

        //- Our capabilities
        section.p-top-feature
            .l-container
                .c-heading-section.p-top-feature__head
                    p.c-heading-section__label.u-anim.js-visible DOWA’s Strengths and Track Record
                    h2.c-heading-section__title.u-anim.js-visible(style="--i: 1") Our capabilities
                .p-top-feature__body
                    p.p-top-feature__lead.u-anim.js-visible Since jointly establishing NIPPON PGM in 1991, DOWA has expanded its catalyst recycling business, recovering platinum group metals such as platinum, palladium, and rhodium from spent catalysts.
                    .p-top-feature__list
                        each f, i in features
                            .c-card-feature.u-anim.js-visible
                                figure.c-card-feature__figure.u-anim-zoom
                                    img(src=img + "p-top-feature" + (i + 1) + ".webp" alt="" width=720 height=500 loading="lazy")
                                .c-card-feature__body
                                    p.c-line-num 0#{i + 1}
                                    .c-card-feature__text
                                        h3.c-card-feature__title= f.title
                                        p.c-card-feature__desc= f.desc

        //- Voice
        section.p-top-voice
            .l-container
                .c-heading-section.p-top-voice__head
                    p.c-heading-section__label.u-anim.js-visible Customer testimonials
                    h2.c-heading-section__title.u-anim.js-visible(style="--i: 1") Voice
                .js-card-slider.u-anim-fade.js-visible
                    .p-top-voice__slider.swiper
                        .swiper-wrapper
                            each v, i in voices
                                .swiper-slide
                                    article.c-card-voice
                                        figure.c-card-voice__figure
                                            img(src=img + "p-top-voice" + (i + 1) + ".webp" alt="" width=940 height=680 loading="lazy")
                                        .c-card-voice__body
                                            p.c-line-num 0#{i + 1}
                                            .c-card-voice__content
                                                h3.c-card-voice__title= v.title
                                                if v.text
                                                    p.c-card-voice__text= v.text
                                                p.c-card-voice__client
                                                    span.c-card-voice__client-label CLIENT:#{" "}
                                                    = v.client
                    .c-btn-ctrl-group.p-top-voice__ctrl
                        button.c-btn-ctrl.c-btn-ctrl--prev.js-card-slider-prev(type="button" aria-label="Previous testimonial")
                            svg(aria-hidden="true")
                                use(href="#ico_arrow_ne")
                        button.c-btn-ctrl.c-btn-ctrl--next.js-card-slider-next(type="button" aria-label="Next testimonial")
                            svg(aria-hidden="true")
                                use(href="#ico_arrow_ne")

        //- News（一覧・詳細は WP で作る）
        section.p-top-news
            .l-container
                .p-top-news__inner
                    h2.p-top-news__title.u-anim.js-visible News
                    .p-top-news__list
                        each item, i in news
                            a.c-card-news.c-card-news--outline.u-anim.js-visible(href=home + "single-news/" style="--i: " + i)
                                .c-card-news__body
                                    .c-card-news__meta
                                        time.c-card-news__date(datetime=item.date)= item.label
                                        span.c-card-news__tag= item.tag
                                    p.c-card-news__title= item.title
                    .p-top-news__more.u-anim.js-visible
                        a.c-link-arrow.c-link-arrow--lg(href=home + "news/")
                            span.c-link-arrow__label View all
                            span.c-btn-arrow.c-link-arrow__arrow
                                svg(aria-hidden="true")
                                    use(href="#ico_arrow_ne")

        //- NIPPON PGM’s expertise（フッター直前の写真の帯）
        section.p-top-technology.is-section-dark
            picture.p-top-technology__bg.u-anim-zoom.js-visible
                source(media="(min-width: 641px)" srcset=img + "p-top-technology-bg.webp" width=2880 height=1800)
                img(src=img + "p-top-technology-bg-sp.webp" alt="" width=804 height=1400 loading="lazy")
            .l-container.p-top-technology__inner
                p.p-top-technology__route.u-anim.js-visible
                    span FROM
                    span AKITA
                    span TO THE WORLD
                .p-top-technology__body
                    .p-top-technology__head
                        //- 「テクノロジーはハイテク産業を連想するので PGM Expertise に」（英訳確認シート 01）
                        p.p-top-technology__label.u-anim.js-visible PGM Expertise
                        h2.p-top-technology__title.u-anim.js-visible(style="--i: 1") NIPPON PGM’s Expertise in Sampling, Assaying, and Smelting
                    p.p-top-technology__desc.u-anim.js-visible(style="--i: 2") NIPPON PGM’s proprietary ROSE Process is a highly efficient PGM recovery technology jointly developed by DOWA Metals &amp; Mining Co., Ltd. and Tanaka Precious Metal Technologies Co., Ltd. With a processing capacity of approximately 1,000 metric tons per month, it efficiently handles a wide range of PGM-bearing materials. This large-scale processing capability enables DOWA to offer competitive catalyst recycling services.
                    .p-top-technology__action.u-anim.js-visible(style="--i: 3")
                        a.c-btn.c-btn--lg(href=home + "technology/")
                            span.c-btn__label Learn more
                            span.c-btn-arrow.c-btn-arrow--lg
                                svg(aria-hidden="true")
                                    use(href="#ico_arrow_ne")
