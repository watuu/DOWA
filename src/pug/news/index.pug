extends ../_default
block vars
    - var path = "../"
    - var title = "新着情報"
    - var pageClass = "page-news"
    - var breadcrumb = "新着情報"

block content

    -
        var newsList = [
            { date: "2026-07-15", label: "2026.07.15", tag: "お知らせ", title: "新たな白金族金属（PGM）リサイクル設備の稼働を開始しました。" },
